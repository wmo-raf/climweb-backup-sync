# Path to the climweb backup directory on the host
BACKUP_DIR="/home/user/climweb/climweb/backup"

# A short name for this installation, used in remote filenames
# e.g. "zambia" produces: zambia-db-2026-05-27.psql.bin
SITE_NAME=climweb

# Google Drive service account credentials (base64-encoded JSON key file).
# How to get this value:
#   Mac/Linux : base64 -w0 service-account.json   (copy the output)
#   Windows   : Run in PowerShell:
#               [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) | clip
# Paste the result here. The container will decode it automatically at startup.
# Leave blank if you are using OneDrive or placing the JSON file manually.
SERVICE_ACCOUNT_JSON_B64=

# Remote folder for rclone (Google Drive, OneDrive, etc.)
# Format: <remote_name>:<folder_path>/
# The script creates db/ and media/ subdirectories inside this folder.
REMOTE_FOLDER="gdrive:ClimWeb Backups/"

# How many days of DB backups to keep on the remote
# DB files are small (~3–5 MB), so 30 days ≈ 90–150 MB
DB_RETENTION_DAYS=10

# How many days of media backups to keep on the remote
# Media is uploaded weekly, so 3 days = 1 weekly snapshot
MEDIA_RETENTION_DAYS=3

# Day of the week to upload the media backup (1=Monday, 7=Sunday)
# Media is large and changes slowly, so weekly is enough
MEDIA_UPLOAD_WEEKDAY=1

# ---------------------------------------------------------------------------
# Variables for rsync backup to another server (Backup-to-Remote-Server.md)
# ---------------------------------------------------------------------------
DEST_PATH=user@ip_address:/data/backups/

# Optional: path to a custom SSH private key (leave blank to use ~/.ssh defaults)
SSH_KEY_PATH=
